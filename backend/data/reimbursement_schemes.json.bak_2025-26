{
  "schemes": [
    {
      "scheme_code": "1-A",
      "name": "Annual Grants to Divisional / District Cricket Associations",
      "scheme_type": "Annual_Grant",
      "eligible_bodies": [
        "Division",
        "District"
      ],
      "frequency": "Annual",
      "description": "Annual grants passed on to Districts via Divisions to support their cricket development activities. Amount is subject to a ceiling and based on previous spending patterns.",
      "heads": [
        {
          "code": "GRANT_PER_DIST",
          "label": "Grant per District (via Division)",
          "unit": "per_district_per_year",
          "rate_inr": 110000,
          "rate_display": "₹1,10,000 / District / year"
        },
        {
          "code": "DIV_RETAINED",
          "label": "Division-retained amount",
          "unit": "per_district_per_year",
          "rate_inr": 30000,
          "rate_display": "₹30,000 / District / year"
        }
      ],
      "required_documents": [
        "Utilization Certificate (CA-certified) for last grant",
        "Confirmation of Division's registration under Societies Registration Act",
        "Auditor's Report & Audited Statement of Accounts (previous FY)",
        "Notice & Draft Minutes of AGM (attested by Hon. Secretary)",
        "List of Divisional Association members as on AGM date",
        "Annual Budget of the Division",
        "Documents submitted to Registrar of Firms & Societies + challan copy",
        "Bank statement showing last annual grant payment to Districts",
        "For Districts: Auditor's Report, Balance Sheet, I&E / R&P (previous FY)",
        "For Districts: Notice & Draft Minutes of AGM",
        "For Districts: List of District Association members as on AGM date"
      ],
      "conditions": [
        "Grant ceiling assessed against District's spending pattern over previous 2-3 years",
        "If spending pattern < 80% of ceiling, average amount (not ceiling) is paid",
        "Grant must be claimed within 12 months of previous FY closure, else forfeited"
      ]
    },
    {
      "scheme_code": "1-B",
      "name": "Share to Divisions out of Net Revenue from ODI / T20",
      "scheme_type": "Revenue_Share",
      "eligible_bodies": [
        "Division"
      ],
      "frequency": "Per_International_Match",
      "description": "A percentage of net revenue from International ODIs and T20s hosted by MPCA is shared with the Divisions.",
      "heads": [
        {
          "code": "DIV_SHARE",
          "label": "Division's Share",
          "unit": "percent_of_surplus",
          "rate_inr": 0,
          "rate_display": "4% of surplus per Division / match"
        }
      ],
      "required_documents": [
        "Copies of Fixed Deposit instruments for earmarked investments",
        "Written norms for schemes funded (District Incentive / Junior Rewards)",
        "CA-certified Utilization Certificate for surplus spent on infra/common expenditure"
      ],
      "conditions": [
        "Applicable for ODI & T20 matches only",
        "Test Matches on case-to-case basis",
        "70% of share must be utilised for earmarked FD for District incentive / junior rewards / infra",
        "30% may be used for other common Division expenditure",
        "Chronological UC submission required for next share release"
      ]
    },
    {
      "scheme_code": "2-A",
      "name": "Inter-School Tournament Subsidy",
      "scheme_type": "Reimbursement",
      "eligible_bodies": [
        "Division",
        "District"
      ],
      "frequency": "Per_tournament",
      "description": "Subsidy for hosting Inter-School tournaments at Divisional and District levels, covering match-day costs.",
      "categories": [
        "School"
      ],
      "heads": [
        {
          "code": "PER_DAY_GRANT",
          "label": "Per-day grant (balls/ground/trophies)",
          "unit": "per_day",
          "rate_inr": 5000,
          "rate_display": "₹5,000 / day"
        },
        {
          "code": "UMPIRE_FEES",
          "label": "Umpire fees",
          "unit": "per_official_per_day",
          "rate_inr": 700,
          "rate_display": "₹700 / umpire / day (+ ₹100 if far)"
        },
        {
          "code": "SCORER_FEES",
          "label": "Scorer fees",
          "unit": "per_official_per_day",
          "rate_inr": 500,
          "rate_display": "₹500 / scorer / day (+ ₹100 if far)"
        }
      ],
      "required_documents": [
        "Statement of matches / format / days",
        "Declaration of entry-fee collection",
        "Supporting bills"
      ],
      "conditions": [
        "Only year-round cricket-promoting schools (max 12 at Div HQ, 8 at District)",
        "No accommodation/food/travel — local players only",
        "Players must be registered with school since start of academic year",
        "Segregate district vs city schools; top district teams invited to city phase",
        "Entry fee ₹1,500/school mandatory & declared"
      ]
    },
    {
      "scheme_code": "2-B",
      "name": "Inter-District Tournament Subsidy",
      "scheme_type": "Reimbursement",
      "eligible_bodies": [
        "Division"
      ],
      "frequency": "Per_tournament",
      "description": "Subsidy for hosting Inter-District tournaments covering accommodation, food, travel and match-day expenses.",
      "categories": [
        "Open",
        "U-23",
        "U-18",
        "U-15",
        "U-13"
      ],
      "heads": [
        {
          "code": "ACCOM",
          "label": "Accommodation — outstation",
          "unit": "per_person_per_day",
          "rate_inr": 500,
          "rate_display": "₹500 / member / day"
        },
        {
          "code": "FOOD_MATCH",
          "label": "Food — match days",
          "unit": "per_person_per_day",
          "rate_inr": 350,
          "rate_display": "₹350 / member (max 40 pax)"
        },
        {
          "code": "DINNER",
          "label": "Dinner — outstation",
          "unit": "per_person_per_day",
          "rate_inr": 150,
          "rate_display": "₹150 / outstation member"
        },
        {
          "code": "MISC",
          "label": "Miscellaneous expenses",
          "unit": "per_day",
          "rate_inr": 3600,
          "rate_display": "₹3,600 or ₹4,200 / day"
        },
        {
          "code": "UMPIRE_FEES",
          "label": "Umpire fees",
          "unit": "per_official_per_day",
          "rate_inr": 700,
          "rate_display": "₹700 / day"
        },
        {
          "code": "SCORER_FEES",
          "label": "Scorer fees",
          "unit": "per_official_per_day",
          "rate_inr": 500,
          "rate_display": "₹500 / day"
        },
        {
          "code": "MOM",
          "label": "Man of the Match",
          "unit": "per_match",
          "rate_inr": 1500,
          "rate_display": "₹1,500 / multi-day match"
        },
        {
          "code": "PRIZE_1",
          "label": "Team prize — Rank 1",
          "unit": "per_team_lump",
          "rate_inr": 30000,
          "rate_display": "₹30,000 (Open/U-23) or ₹20,000"
        },
        {
          "code": "PRIZE_2",
          "label": "Team prize — Rank 2",
          "unit": "per_team_lump",
          "rate_inr": 20000,
          "rate_display": "₹20,000 (Open/U-23) or ₹15,000 (if 5+ Districts)"
        }
      ],
      "required_documents": [
        "Fixtures",
        "Scoresheets",
        "Original bills/receipts/vouchers",
        "Photocopy of tickets for visiting team travel"
      ],
      "conditions": [
        "Per-day ceiling applies (accommodation+food+dinner+misc+travel)",
        "Players within 10km of venue: no hotel/dinner",
        "Coach/manager/trainer fees within per-day ceiling",
        "Claim only on tournament completion"
      ]
    },
